  "ExternalDatabaseInfo": {
    "DataBaseType": "6db454c0-531c-4395-9122-921a18942902",
    "ConnectionId": "SqlServer1",
    "SourceTableName": "V投入計画_受注側作業",
    "SourceTableSchema": "dbo",
    "CreateViewSql": "(\r\n\r\nselect JG.*,\r\nHK.データ設定日,\r\nHK.設定日付_1,\r\nHK.製造ライン名_1,\r\nHK.枠名_1,\r\nHK.担当_1,\r\nHK.エンジン_1,\r\nHK.充当先_1,\r\nHK.受注確定期限_1,\r\nHK.大型小型個別_1,\r\nHK.計画生産メニュー工事_1,\r\nHK.出図_1,\r\nHK.積層投入_1,\r\nHK.組立投入日_1,\r\nHK.種別_1,\r\nHK.エンジン必要日_1,\r\nHK.標準LO予定日_1,\r\nHK.標準完成予定日_1,\r\nHK.設定日付_2,\r\nHK.製造ライン名_2,\r\nHK.枠名_2,\r\nHK.担当_2,\r\nHK.エンジン_2,\r\nHK.充当先_2,\r\nHK.受注確定期限_2,\r\nHK.大型小型個別_2,\r\nHK.計画生産メニュー工事_2,\r\nHK.出図_2,\r\nHK.積層投入_2,\r\nHK.組立投入日_2,\r\nHK.種別_2,\r\nHK.エンジン必要日_2,\r\nHK.標準LO予定日_2,\r\nHK.標準完成予定日_2,\r\nTH.設定ステータス,\r\nTH.ステータス\r\nfrom 投入計画_受注側作業 JG left join 投入計画変化管理 HK on JG.艇種 = HK.艇種 and JG.艇番 = HK.艇番\r\n                          left join 投入計画_長期部材管理トランザクションヘッダ TH on JG.艇種 = TH.艇種 and JG.艇番 = TH.艇番\r\nwhere 大型小型個別_1 is not null or (大型小型個別_1 is null and (長納期部材仕様確認<>'完了' or 長納期部材社内展開<>'完了' or 仕様確定<>'完了' or 見積作成<>'完了'))\r\n\r\n)",
    "ViewInfo": {
      "ViewName": "V投入計画_受注側作業",
      "IsUpdatable": true,
      "QueryColumns": [
        "艇種",
        "艇番"
      ]
    }
  },
  "Indexes": []
}